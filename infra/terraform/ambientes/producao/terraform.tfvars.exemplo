# Copie para terraform.tfvars (que o .gitignore ignora) e preencha. Nada aqui
# é segredo do app: senhas e chaves são geradas pelo Terraform e vão direto
# para o Secrets Manager e o SSM, sem passar por este arquivo nem pelo state.
#
# `versao_imagem` não fica aqui: o pipeline passa o SHA do commit a cada deploy.

# Seu IP público em /32 (descubra com: curl.exe -s https://checkip.amazonaws.com).
cidrs_grafana = ["203.0.113.10/32"]

# Alerta de gasto.
orcamento_mensal_usd = 10
emails_alerta        = ["seu-email@exemplo.com"]

# Os padrões já seguem a arquitetura combinada; mude só se precisar.
# quantidade_tarefas             = 2
# usar_fargate_spot              = true
# tipo_instancia_observabilidade = "t3.medium"
# variaveis_app = {
#   RELEASE_ADIANTAMENTO_DIAS = "7"
# }
